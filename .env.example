# Copy this file to .env and set both required passwords before starting Compose.
# Avoid semicolons, dollar signs, quotes, and spaces in passwords used in connection strings.
# SQL Server passwords must be at least 8 characters and use at least 3 of:
# uppercase letters, lowercase letters, digits, and symbols.
MSSQL_SA_PASSWORD=
REDIS_PASSWORD=

# Optional local development overrides
ASPNETCORE_ENVIRONMENT=Development
# BACKEND_PORT=5202
# SQL_PORT=1433
# REDIS_PORT=6379
