# Copy this file to .env and set both required passwords before starting Compose.
# Avoid semicolons, dollar signs, quotes, and spaces in passwords used in connection strings.
# SQL Server passwords must be at least 8 characters and use at least 3 of:
# uppercase letters, lowercase letters, digits, and symbols.
MSSQL_SA_PASSWORD=
REDIS_PASSWORD=
# Required: at least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional OAuth2 providers. A provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional SPA origin allowed as an OAuth return URL (no trailing slash), e.g. http://localhost:4003
# AUTH_ALLOWED_RETURN_ORIGIN=

# Optional local development overrides
ASPNETCORE_ENVIRONMENT=Development
# BACKEND_PORT=5202
# SQL_PORT=1433
# REDIS_PORT=6379
